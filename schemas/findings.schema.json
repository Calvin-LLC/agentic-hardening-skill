{
  "$comment": "Agent packet. scripts/validate-findings.cjs adds the cross-field rules this schema cannot express.",
  "type": "object",
  "required": [
    "agent",
    "scope",
    "coverage",
    "findings",
    "limitations",
    "recommendations"
  ],
  "properties": {
    "agent": {
      "enum": [
        "security",
        "reliability",
        "tests",
        "a11y"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "paths",
        "technologies"
      ],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "disposition",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "control": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "disposition": {
            "enum": [
              "assessed",
              "not-applicable",
              "not-assessable",
              "blocked"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "skill",
        "checks",
        "entry_points"
      ],
      "additionalProperties": false,
      "properties": {
        "skill": {
          "enum": [
            "wcag"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "tree",
              "keyboard",
              "contrast",
              "targets",
              "reflow"
            ]
          }
        },
        "entry_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "test_health": {
      "enum": [
        "good",
        "fair",
        "poor",
        "none"
      ]
    },
    "commands_discovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "agent",
        "control",
        "category",
        "fingerprint",
        "status",
        "affected",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HARDEN-[A-Z0-9]+-[0-9]{3,}$"
        },
        "title": {
          "$ref": "#/$defs/line"
        },
        "agent": {
          "enum": [
            "security",
            "reliability",
            "tests",
            "a11y"
          ]
        },
        "control": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "category": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owasp_2025": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^A(0[1-9]|10)$"
            },
            "llm_2026": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^LLM(0[1-9]|10)$"
            },
            "asi_2026": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^ASI(0[1-9]|10)$"
            },
            "wcag": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[1-4]\\.[0-9]+\\.[0-9]+$"
              }
            },
            "cwe": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              }
            }
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
          "maxLength": 200
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "status": {
          "enum": [
            "open",
            "needs-validation",
            "hardening-note"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reachability": {
          "enum": [
            "confirmed",
            "plausible",
            "speculative",
            "not-reachable"
          ]
        },
        "evidence_quality": {
          "enum": [
            "strong",
            "medium",
            "weak"
          ]
        },
        "affected": {
          "type": "object",
          "required": [
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "claim_type",
              "excerpt"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^(code-[a-z]+(-[a-z]+)*|absence-grep|deployment-probe|analysis)$"
              },
              "claim_type": {
                "enum": [
                  "observed",
                  "inferred",
                  "normative"
                ]
              },
              "excerpt": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "impact": {
          "$ref": "#/$defs/line"
        },
        "exploit_preconditions": {
          "$ref": "#/$defs/line"
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "immediate": {
              "$ref": "#/$defs/line"
            },
            "durable": {
              "$ref": "#/$defs/line"
            }
          }
        },
        "verification": {
          "$ref": "#/$defs/line"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "retrieved",
              "claim",
              "source_type"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "retrieved": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "claim": {
                "$ref": "#/$defs/line"
              },
              "source_type": {
                "enum": [
                  "primary",
                  "vendor",
                  "secondary"
                ]
              }
            }
          }
        },
        "false_positive_notes": {
          "$ref": "#/$defs/line"
        },
        "also_flagged_by": {
          "type": "array",
          "items": {
            "enum": [
              "security",
              "reliability",
              "tests",
              "a11y"
            ]
          }
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "validation_plan": {
          "$ref": "#/$defs/line"
        },
        "upstream_control": {
          "$ref": "#/$defs/line"
        },
        "regulatory": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "M-26-15",
              "M-26-14",
              "BOD-26-04",
              "CRA",
              "CISA-SBOM-2026",
              "NIST-agent-identity"
            ]
          }
        },
        "handoff": {
          "enum": [
            "wcag"
          ]
        }
      }
    }
  }
}
